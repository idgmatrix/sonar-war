{
  "name": "sonar-war",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "wasm:build": "wasm-pack build dsp-core --target web --out-dir pkg --dev",
    "wasm:build:release": "wasm-pack build dsp-core --target web --out-dir pkg --release",
    "wasm:test": "cargo test --manifest-path dsp-core/Cargo.toml"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
